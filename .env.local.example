# Copy this file to .env.local and fill in your WordPress details.
# While WP_URL is empty/unset, the site renders entirely from lib/mock-data.js.

# Base URL of the headless WordPress install (no trailing slash).
WP_URL=https://smkcbm.sch.id

# Contact form provider. Contact Form 7 6.x exposes its own REST endpoint —
# the old "CF7 to REST API" plugin is not required.
CONTACT_FORM_PROVIDER=cf7

# Numeric Contact Form 7 form ID (wp-admin -> Contact -> Forms).
# Leave blank until a form exists: /api/contact then accepts and logs
# submissions instead of failing. See WORDPRESS-SETUP.md section 4.
CF7_FORM_ID=
