# Copy this file to .env.local and fill in your WordPress details.
# While these are empty/unset, the site renders from lib/mock-data.js so you can
# develop the front-end before the CMS is live.

# Base URL of your headless WordPress install (no trailing slash).
# Example: https://cms.smkcbm.sch.id
WP_URL=

# Contact form integration. Choose ONE strategy on the WP side:
#  - "cf7"     -> Contact Form 7 + "CF7 to REST API" plugin
#  - "wpforms" -> WPForms REST submission
#  - "custom"  -> a custom REST endpoint you expose
CONTACT_FORM_PROVIDER=cf7

# For Contact Form 7: the numeric form ID (from wp-admin -> Contact -> Forms).
CF7_FORM_ID=
