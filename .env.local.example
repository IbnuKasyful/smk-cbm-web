# Copy this file to .env.local and fill in your WordPress details.
# While WP_URL is empty/unset, the site renders entirely from lib/mock-data.js.

# Base URL of the headless WordPress install (no trailing slash). This is the
# only place the CMS domain appears — image hosts and category lookups are all
# derived from it, so a domain move is a one-line change plus a rebuild.
WP_URL=https://wp.smkcbm.sch.id

# Contact form provider. Contact Form 7 6.x exposes its own REST endpoint —
# the old "CF7 to REST API" plugin is not required.
CONTACT_FORM_PROVIDER=cf7

# Numeric Contact Form 7 form ID (wp-admin -> Contact -> Forms).
# Leave blank until a form exists: /api/contact then accepts and logs
# submissions instead of failing. See WORDPRESS-SETUP.md section 4.
CF7_FORM_ID=

# Shared secret for the /api/revalidate webhook, so WordPress can push content
# changes instantly instead of waiting for the 5-minute ISR window. Generate a
# random string and use the same value in the WP mu-plugin
# (docs/wp-revalidate-hook.php). While unset, /api/revalidate returns 503 and
# content still refreshes on the 5-minute timer.
#   PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
REVALIDATE_SECRET=
