{
  "name": "smk-cbm-web",
  "version": "1.0.0",
  "private": true,
  "description": "Headless front-end for SMK Citra Bangsa Mandiri Purwokerto (Next.js + WordPress)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "package": "powershell -ExecutionPolicy Bypass -File ./scripts/package-deploy.ps1",
    "deploy:build": "next build && npm run package",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^16.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "wrangler": "^4.112.0"
  }
}
